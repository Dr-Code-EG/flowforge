# =============================================================================
# Database (defaults to SQLite at ./data/flowforge.sqlite if no driver set)
# =============================================================================
# Uncomment to use Postgres instead of SQLite:
# DATABASE_TYPE=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=flowforge
# DATABASE_PASSWORD=flowforge_dev_password
# DATABASE_NAME=flowforge

# Optional: override SQLite file location
# DATABASE_FILE=./data/flowforge.sqlite

# =============================================================================
# Redis (only needed when EXECUTION_MODE=queue)
# =============================================================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# Backend
# =============================================================================
BACKEND_PORT=3000
JWT_SECRET=change-me-in-production-use-a-long-random-string-min-64-chars
JWT_EXPIRES_IN=7d

# Credential encryption key (32 bytes hex => 64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Execution mode: "regular" runs in-process, "queue" uses BullMQ workers
EXECUTION_MODE=regular

# Public URL used to build webhook URLs shown in the UI
PUBLIC_URL=http://localhost:3000

# =============================================================================
# Frontend (only used in dev)
# =============================================================================
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
